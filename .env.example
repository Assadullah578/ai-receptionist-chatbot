PORT=3000

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=test-db
# Only for cloud databases: the CA certificate text
DB_CA_CERT=

# Gemini API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Password for the admin dashboard (admin.html)
ADMIN_PASSWORD=

# WhatsApp booking confirmations (Meta WhatsApp Cloud API). Leave empty to turn them off.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# WhatsApp Business Account ID (shown on WhatsApp > API Setup). Only needed to create the message template.
WHATSAPP_BUSINESS_ACCOUNT_ID=
# Added in front of numbers typed without a country code (1 = US, 92 = Pakistan)
WHATSAPP_COUNTRY_CODE=1
